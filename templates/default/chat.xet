<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="rocketchat.chat" template="" lang="" group="0" version="19.1">
		<grid height="100%" width="100%">
			<columns>
				<column/>
				<column/>
			</columns>
			<rows>
				<row height="100%">
					<et2-iframe  id="chatbox" width="100%" height="100%"></et2-iframe>
				</row>
			</rows>
		</grid>
	</et2-template>
</overlay>
